{
  "expo": {
    "name": "PocketBook",
    "slug": "pocketbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pocketbook",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "web",
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.pocketbook"
    },
    "android": {
      "package": "com.yourname.pocketbook",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "PocketBook 需要访问您的相册以进行截图记账识别。",
          "cameraPermission": "PocketBook 需要访问您的相机以拍照记账。"
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "07826b65-7ff7-4e22-ab93-5f82e1bba9ee"
      }
    }
  }
}
